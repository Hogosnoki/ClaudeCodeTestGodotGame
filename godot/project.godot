; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are meant to be edited using the UI.

config_version=5

[application]

config/name="ProcGenGame"
run/main_scene="res://Scenes/DaggerDeep.tscn"
config/features=PackedStringArray("4.4", "C#", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[dotnet]

project/assembly_name="ProcGenGame"

